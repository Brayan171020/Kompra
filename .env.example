# Shared development variables (see apps/api/.env.example for API details)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-fancy-star-b5njfgl0.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
# Required by the Neon Next.js session-cookie proxy; generate a separate 32+ character secret.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAGIC_LINK_WEBHOOK_URL=
# Server-side Managed Auth endpoint (same Neon URL as NEXT_PUBLIC_NEON_AUTH_URL).
NEON_AUTH_BASE_URL=https://ep-fancy-star-b5njfgl0.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
